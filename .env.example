# Local dev (docker-compose): postgresql://koeki:koeki@localhost:5432/koeki?schema=public
# Production (Supabase): use the "Transaction pooler" connection string (port 6543)
# from Project Settings > Database. Requires DIRECT_URL below for migrations.
DATABASE_URL="postgresql://koeki:koeki@localhost:5432/koeki?schema=public"
# Supabase "Direct connection" string (port 5432) — used only by `prisma migrate
# deploy`, which cannot run through the pgbouncer pooler. Same as DATABASE_URL
# for local dev.
DIRECT_URL="postgresql://koeki:koeki@localhost:5432/koeki?schema=public"
AUTH_SECRET="replace-with-a-distinct-32-byte-secret"
APP_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_GUILD_ID=""
INVITE_TOKEN_PEPPER="replace-with-a-distinct-pepper"
INTERNAL_CRON_SECRET="replace-with-a-distinct-cron-secret"
STORAGE_PROVIDER="s3"
STORAGE_BUCKET=""
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
# Optional: Discord webhook URL for the weekly recovery digest (posted by
# `pnpm worker reminders:discord`). Leave empty to disable — the job then
# no-ops instead of failing.
RECOVERY_WEBHOOK_URL=""
# Only ninjas with at least this much overdue debt (in ryō) appear in the digest.
RECOVERY_WEBHOOK_MIN_DEBT="0"
DEMO_MODE="true"

